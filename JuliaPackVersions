# Create a persistent Julia package environment
mkdir -p /opt/julia-environment /opt/julia-depot

export JULIA_DEPOT_PATH=/opt/julia-depot
JULIA=/usr/local/bin/julia

"$JULIA" --project=/opt/julia-environment -e '
using Pkg

packages = [
    Pkg.PackageSpec(name="DifferentialEquations", version="7.6.0"),
    Pkg.PackageSpec(name="Measures", version="0.3.2"),
    Pkg.PackageSpec(name="DataFrames", version="1.7.0"),
    Pkg.PackageSpec(name="JLD2", version="0.5.11"),
    Pkg.PackageSpec(name="BlackBoxOptim", version="0.6.3"),
    Pkg.PackageSpec(name="DiffEqBase", version="6.108.0"),
    Pkg.PackageSpec(name="OrdinaryDiffEq", version="6.33.3"),
    Pkg.PackageSpec(name="HypothesisTests", version="0.11.3"),
    Pkg.PackageSpec(name="StatsBase", version="0.34.4"),
    Pkg.PackageSpec(name="ODEInterfaceDiffEq", version="3.12.0"),
    Pkg.PackageSpec(name="StatsPlots", version="0.15.7"),
    Pkg.PackageSpec(name="CSV", version="0.10.15"),
    Pkg.PackageSpec(name="Plots", version="1.40.11"),
    Pkg.PackageSpec(name="Sundials", version="4.15.1"),
    Pkg.PackageSpec(name="KernelDensity", version="0.6.9"),
    Pkg.PackageSpec(name="EasyFit", version="0.6.8"),
    Pkg.PackageSpec(name="BayesianOptimization", version="0.2.5"),
    Pkg.PackageSpec(name="CmdStan", version="6.6.0"),
    Pkg.PackageSpec(name="GaussianProcesses", version="0.12.5"),
    Pkg.PackageSpec(name="PairPlots", version="2.9.3"),
    Pkg.PackageSpec(name="CairoMakie", version="0.12.18"),
    Pkg.PackageSpec(name="JLD", version="0.13.5"),
    Pkg.PackageSpec(name="LaTeXStrings", version="1.4.0"),
    Pkg.PackageSpec(name="Distributions", version="0.25.118"),
    Pkg.PackageSpec(name="Trapz", version="2.0.3"),
]

Pkg.activate("/opt/julia-environment")
Pkg.add(packages)
Pkg.precompile()
Pkg.status()
'
